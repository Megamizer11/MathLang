abs(n) = (#IF n, n) + (#IF -n, -n)
sign(n) = (#IF n, 1) + (#IF -n, -1)

if0(n, k) = #IF n, k  #COM при n <=0 возвращает 0, удобно использовать логическое ИЛИ:
#COM (#IF sign(n), res) + (#IF sign(-n), res2) + (#IF -(sign(n)^2) + 1, res3) - равносильно: if n>0: return res; if n<0: return res2; if n==0: return res3
#COM Здесь используется трюк: sign(n) возвращает знак n (-1, 0, 1), если возвести sign(n) в квадрат: (1, 0, 1), умножить
#COM на -1: (-1, 0, -1) и прибавить 1: (0, 1, 0), то под условие #IF будет попадать только среднее значение, соответсвующее n=0

fullif(cond, gr, ls, zer) = (#IF sign(n), gr) + (#IF sign(-n), ls) + (#IF -(sign(n)^2) + 1, zer)  #COM cond>0 => gr, cond<0 => ls, cond=0 => zer

if1(n, k) = (#IF n, k-1) + 1  #COM при n <=0 возвращает 1, удобно использовать логическое И:
#COM (#IF n, res) * (#IF k, res) - равносильно: if (n && k): return res

equals(n, k) = (#IF -(sign(n-k)^2) + 1, 1) #COM если n=k, возвращает 1, иначе 0


sum_of_progression(n) = n + (#IF n, sum_of_progression(n-1))
factorial(n) = n * ((#IF n-1, factorial(n-1)-1)+1)
#COM factorial(n) = n * if1(n-1, factorial(n-1))
#COM рекурсия между функциями пока что не работает, т.к. она вычисляется по принципу: чтобы вычислить f(5), мне нужно f(4),
#COM чтобы вычислить f(4), мне нужно f(3), ... чтобы вычилсить f(1), мне нужно f(0), чтобы вычислить f(0), мне нужно f(-1) и т.д.
#COM Даже если вычисление if1(n, k) при n=0 не требует k, оно всё равно вычисляется первее

#PRINT abs(-5)
#PRINT sum_of_progression(7)  #COM 28, развернётся в: 1+2+3+4+5+6+7
factorial(5)