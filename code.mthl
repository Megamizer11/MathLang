a = (#SUM n=1, 5, n^n) ^ 2
#PRINT a  #COM 11648569

f(x) = x * f(x-1) #COM рекурсия не поддерживается, т.к. нет условия выхода
e = 2.718281828459045
fct(n) = e ^ (#SUM k=1, n, #LN k)
#COM b = (#LN 1) + (#LN 2) + (#LN 3) + (#LN 4) + (#LN 5)
#COM a = 1.0001 ^ 4.8  #COM переполнение стека
fct(5)  #COM 119.9999999782, почти 120